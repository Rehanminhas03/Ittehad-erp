generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["accounts", "audit", "core", "parts", "sales", "service"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Account {
  id           BigInt        @id @default(autoincrement())
  dealershipId BigInt        @map("dealership_id")
  code         String
  name         String
  type         String
  role         String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  BigInt?       @map("created_by_id")
  updatedById  BigInt?       @map("updated_by_id")
  createdBy    User?         @relation("account_created_by_idTouser", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "account_created_by_id_user_id_fk")
  dealership   Dealership    @relation(fields: [dealershipId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "account_dealership_id_dealership_id_fk")
  updatedBy    User?         @relation("account_updated_by_idTouser", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "account_updated_by_id_user_id_fk")
  journalLines JournalLine[]

  @@unique([dealershipId, code], map: "account_dealershipId_code_unique")
  @@unique([dealershipId, role], map: "account_role_uq", where: raw("(role IS NOT NULL)"))
  @@index([createdById], map: "account_created_by_id_index")
  @@index([dealershipId], map: "account_dealership_id_index")
  @@index([updatedById], map: "account_updated_by_id_index")
  @@map("account")
  @@schema("accounts")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Invoice {
  id                 BigInt              @id @default(autoincrement())
  dealershipId       BigInt              @map("dealership_id")
  branchId           BigInt?             @map("branch_id")
  legalEntityId      BigInt?             @map("legal_entity_id")
  accountingEntityId BigInt?             @map("accounting_entity_id")
  invoiceNo          String              @unique(map: "invoice_invoiceNo_unique") @map("invoice_no")
  kind               String
  customerId         BigInt              @map("customer_id")
  sourceType         String              @map("source_type")
  sourceId           BigInt              @map("source_id")
  sourceNo           String?             @map("source_no")
  invoiceDate        DateTime            @map("invoice_date") @db.Date
  dueDate            DateTime            @map("due_date") @db.Date
  subtotal           Decimal             @db.Decimal(14, 2)
  taxAmount          Decimal             @map("tax_amount") @db.Decimal(14, 2)
  totalAmount        Decimal             @map("total_amount") @db.Decimal(14, 2)
  amountPaid         Decimal             @default(0) @map("amount_paid") @db.Decimal(14, 2)
  notes              String?
  journalEntryId     BigInt?             @map("journal_entry_id")
  status             String              @default("draft")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        BigInt?             @map("created_by_id")
  updatedById        BigInt?             @map("updated_by_id")
  accountingEntity   AccountingEntity?   @relation(fields: [accountingEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_accounting_entity_id_accounting_entity_id_fk")
  branch             Branch?             @relation(fields: [branchId, dealershipId], references: [id, dealershipId], onDelete: NoAction, onUpdate: NoAction, map: "invoice_branch_id_dealership_id_branch_id_dealership_id_fk")
  createdBy          User?               @relation("invoice_created_by_idTouser", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_created_by_id_user_id_fk")
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_customer_id_customer_id_fk")
  dealership         Dealership          @relation(fields: [dealershipId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_dealership_id_dealership_id_fk")
  journalEntry       JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_journal_entry_id_journal_entry_id_fk")
  legalEntity        LegalEntity?        @relation(fields: [legalEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_legal_entity_id_legal_entity_id_fk")
  updatedBy          User?               @relation("invoice_updated_by_idTouser", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_updated_by_id_user_id_fk")
  invoiceLines       InvoiceLine[]
  paymentAllocations PaymentAllocation[]

  @@unique([sourceType, sourceId], map: "invoice_source_live_uq", where: raw("(status <> ALL (ARRAY['void'::text, 'cancelled'::text]))"))
  @@index([accountingEntityId], map: "invoice_accounting_entity_id_index")
  @@index([branchId], map: "invoice_branch_id_index")
  @@index([createdById], map: "invoice_created_by_id_index")
  @@index([customerId], map: "invoice_customer_id_index")
  @@index([dealershipId, status], map: "invoice_dealership_id_status_index")
  @@index([dueDate], map: "invoice_due_date_index")
  @@index([journalEntryId], map: "invoice_journal_entry_id_index")
  @@index([legalEntityId], map: "invoice_legal_entity_id_index")
  @@index([updatedById], map: "invoice_updated_by_id_index")
  @@map("invoice")
  @@schema("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model InvoiceLine {
  id           BigInt     @id @default(autoincrement())
  dealershipId BigInt     @map("dealership_id")
  invoiceId    BigInt     @map("invoice_id")
  kind         String
  description  String
  partNo       String?    @map("part_no")
  quantity     Decimal    @db.Decimal(12, 2)
  unitPrice    Decimal    @map("unit_price") @db.Decimal(14, 2)
  amount       Decimal    @db.Decimal(14, 2)
  taxRate      Decimal    @map("tax_rate") @db.Decimal(5, 2)
  taxAmount    Decimal    @map("tax_amount") @db.Decimal(14, 2)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_line_dealership_id_dealership_id_fk")
  invoice      Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invoice_line_invoice_id_invoice_id_fk")

  @@index([dealershipId], map: "invoice_line_dealership_id_index")
  @@index([invoiceId], map: "invoice_line_invoice_id_index")
  @@map("invoice_line")
  @@schema("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model JournalEntry {
  id                 BigInt            @id @default(autoincrement())
  dealershipId       BigInt            @map("dealership_id")
  branchId           BigInt?           @map("branch_id")
  legalEntityId      BigInt?           @map("legal_entity_id")
  accountingEntityId BigInt?           @map("accounting_entity_id")
  entryNo            String            @unique(map: "journal_entry_entryNo_unique") @map("entry_no")
  entryDate          DateTime          @map("entry_date") @db.Date
  source             String
  sourceType         String?           @map("source_type")
  sourceId           BigInt?           @map("source_id")
  memo               String
  totalAmount        Decimal           @map("total_amount") @db.Decimal(14, 2)
  reversalOfId       BigInt?           @unique(map: "journal_entry_reversal_uq", where: raw("(reversal_of_id IS NOT NULL)")) @map("reversal_of_id")
  postedById         BigInt            @map("posted_by_id")
  postedAt           DateTime          @default(now()) @map("posted_at") @db.Timestamptz(6)
  invoices           Invoice[]
  accountingEntity   AccountingEntity? @relation(fields: [accountingEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "journal_entry_accounting_entity_id_accounting_entity_id_fk")
  branch             Branch?           @relation(fields: [branchId, dealershipId], references: [id, dealershipId], onDelete: NoAction, onUpdate: NoAction, map: "journal_entry_branch_id_dealership_id_branch_id_dealership_id_f")
  dealership         Dealership        @relation(fields: [dealershipId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "journal_entry_dealership_id_dealership_id_fk")
  legalEntity        LegalEntity?      @relation(fields: [legalEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "journal_entry_legal_entity_id_legal_entity_id_fk")
  user               User              @relation(fields: [postedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "journal_entry_posted_by_id_user_id_fk")
  journalLines       JournalLine[]
  payments           Payment[]

  @@index([accountingEntityId], map: "journal_entry_accounting_entity_id_index")
  @@index([branchId], map: "journal_entry_branch_id_index")
  @@index([dealershipId, entryDate], map: "journal_entry_dealership_id_entry_date_index")
  @@index([legalEntityId], map: "journal_entry_legal_entity_id_index")
  @@index([postedById], map: "journal_entry_posted_by_id_index")
  @@index([sourceType, sourceId], map: "journal_entry_source_type_source_id_index")
  @@map("journal_entry")
  @@schema("accounts")
}


NODE_ENV=development
PORT=4000
# Runtime connection: non-owner role, so Postgres Row-Level Security applies.
DATABASE_URL=postgres://dms_app:dms_app@127.0.0.1:5432/dms
# Owner connection: Prisma migrations (prisma.config.ts), permission sync and seeding only.
MIGRATION_DATABASE_URL=postgres://dms:dms@127.0.0.1:5432/dms
# Optional: scratch database for `prisma migrate dev` (creating migrations); Prisma may wipe it.
SHADOW_DATABASE_URL=postgres://dms:dms@127.0.0.1:5432/dms_shadow
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Meta lead ads (Facebook / Instagram) -> social media leads for the CROs. See README "Meta lead ads".
META_APP_SECRET=
META_VERIFY_TOKEN=choose-a-long-random-text
# One entry per Facebook Page: the dealership it belongs to (code) and the Page access token.
META_PAGES=[{"pageId":"123456789","dealership":"JET-ITH","accessToken":"EAA..."}]

# Simplest setup (one token for every Page; the leads go to META_DEFAULT_DEALERSHIP). VERIFY_TOKEN works in place of META_VERIFY_TOKEN.
META_APP_ID=
META_ACCESS_TOKEN=
META_DEFAULT_DEALERSHIP=JET-ITH

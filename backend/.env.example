NODE_ENV=development
PORT=4000
# Runtime connection: non-owner role, so Postgres Row-Level Security applies.
DATABASE_URL=postgres://dms_app:dms_app@127.0.0.1:5432/dms
# Owner connection: Prisma migrations (prisma.config.ts), permission sync and seeding only.
MIGRATION_DATABASE_URL=postgres://dms:dms@127.0.0.1:5432/dms
# Optional: scratch database for `prisma migrate dev` (creating migrations); Prisma may wipe it.
SHADOW_DATABASE_URL=postgres://dms:dms@127.0.0.1:5432/dms_shadow
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
